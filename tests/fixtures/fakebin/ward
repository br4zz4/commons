#!/bin/sh
printf 'ward %s\n' "$*" >>"$FAKE_LOG"

pairs_for() {
  case "$1" in
    *.infra.*) printf '%b\n' "${FAKE_WARD_INFRA-I=sekret3}" ;;
    *) printf '%b\n' "${FAKE_WARD_PAIRS-A=sekret1\nB=sekret2}" ;;
  esac
}

case "$1" in
  exec)
    shift
    scopes=""
    while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
      scopes="$scopes $1"
      shift
    done
    shift
    for scope in $scopes; do
      for pair in $(pairs_for "$scope" | sed -e 's/[[:space:]]*=[[:space:]]*/=/'); do
        name=${pair%%=*}
        [ -n "$name" ] || continue
        export "$name=${pair#*=}"
      done
    done
    exec "$@"
    ;;
  secrets)
    shift
    json=0
    if [ "${1-}" = "--json" ]; then
      json=1
      shift
    fi
    if [ "${FAKE_WARD_AIMODE-}" = 1 ]; then
      echo "ward: --json is unavailable in AI mode — secret values are never exposed" >&2
      exit 1
    fi
    if [ "${FAKE_WARD_NOKEY-}" = 1 ]; then
      echo "missing key for vault restricted — 3 file(s) skipped" >&2
      echo "ward: key not found: restricted.secrets.core.code.prod" >&2
      exit 1
    fi
    if [ "${FAKE_WARD_NOSCOPE-}" = 1 ]; then
      echo "ward: key not found: demo.secrets.core.code.dev" >&2
      exit 1
    fi
    if [ "$json" = 1 ]; then
      if [ "${FAKE_WARD_EMPTY-}" = 1 ]; then
        echo "{}"
        exit 0
      fi
      pairs_for "$1" | python3 -I -c 'import json, sys
out = {}
for line in sys.stdin.read().splitlines():
    if not line.strip():
        continue
    name, _, value = line.partition("=")
    out[name.strip()] = value
print(json.dumps(out))'
      exit 0
    fi
    if [ "${FAKE_WARD_EMPTY-}" = 1 ]; then
      exit 0
    fi
    pairs_for "$1" | while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf '\033[32m●\033[0m \033[1m%s\033[0m = %s\n' "${line%%=*}" "${line#*=}"
    done
    printf '\033[32m● active\033[0m \033[33m● overrides\033[0m\n'
    ;;
  *) exit 2 ;;
esac
