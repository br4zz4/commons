#!/bin/sh
set -eu

COMMONS_HOME=$(cd "$(dirname "$0")/.." && pwd)
COMMONS_ROOT="${COMMONS_ROOT:-$PWD}"
COMMONS_ENV_ARG="${ENV-}"
unset ENV
export COMMONS_HOME COMMONS_ROOT

. "$COMMONS_HOME/lib/print.sh"
. "$COMMONS_HOME/lib/ctx.sh"
. "$COMMONS_HOME/lib/image.sh"

side_of_step() {
  case "$1" in
    lint | audit | test | build) echo code ;;
    validate | plan) echo infra ;;
    *) return 1 ;;
  esac
}

default_env_of_step() {
  case "$1" in
    lint | audit | test | validate) echo "$COMMONS_ENV_CHECK" ;;
    build | plan) echo "$COMMONS_ENV_REMOTE" ;;
  esac
}

run_script() {
  dir="$1"
  script="$2"
  shift 2
  [ -f "$script" ] || commons_die "$script não existe"
  CI_CACHE_DIR="$dir/.ci-cache"
  export CI_CACHE_DIR
  if [ -x "$script" ]; then
    commons_run_in "$dir" "$script" "$@"
  fi
  commons_run_in "$dir" sh "$script" "$@"
}

cmd_hook() {
  module="$1"
  step="$2"
  shift 2
  side=$(side_of_step "$step") || commons_die "step $step fora do vocabulário"
  commons_validate_module "$module"
  dir=$(commons_dir "$module" "$side")
  script="$dir/ci/checks/$step.sh"
  case "$step" in
    lint | audit | test)
      if [ -f "$dir/run/$step" ]; then
        if compose_has_service "$module"; then
          run_in_compose "$module" "$step" "$@"
        fi
        script="$dir/run/$step"
      fi
      ;;
  esac
  commons_prepare "$module" "$side" "$(default_env_of_step "$step")"
  run_script "$dir" "$script" "$@"
}

compose_has_service() {
  [ -f "$COMMONS_ROOT/compose.yml" ] || return 1
  (cd "$COMMONS_ROOT" && docker compose --profile '*' config --services 2>/dev/null) | grep -qx "$1"
}

run_in_compose() {
  module="$1"
  name="$2"
  shift 2
  dir=$(commons_dir "$module" code)
  [ -f "$dir/run/$name" ] || commons_die "$dir/run/$name não existe"
  compose_check
  "$COMMONS_HOME/bin/commons" build-image "$module" dev >/dev/null || commons_die "falhou ao construir a imagem de $module"
  cd "$COMMONS_ROOT"
  exec docker compose run --rm --service-ports "$module" "./run/$name" "$@"
}

cmd_run() {
  module="$1"
  name="$2"
  shift 2
  commons_validate_module "$module"
  if compose_has_service "$module"; then
    run_in_compose "$module" "$name" "$@"
  fi
  commons_prepare "$module" code "$COMMONS_ENV_LOCAL"
  dir=$(commons_dir "$module" code)
  run_script "$dir" "$dir/run/$name" "$@"
}

cmd_shell() {
  module="$1"
  commons_prepare "$module" code "$COMMONS_ENV_LOCAL"
  dir=$(commons_dir "$module" code)
  if [ -f "$dir/run/shell" ]; then
    run_script "$dir" "$dir/run/shell"
  fi
  CI_CACHE_DIR="$dir/.ci-cache"
  export CI_CACHE_DIR
  commons_run_in "$dir" sh -c 'sh "$0/lib/dbcheck.sh" warn; exec "$1"' "$COMMONS_HOME" "${SHELL:-sh}"
}

cmd_keys() {
  module="$1"
  commons_validate_module "$module"
  commons_resolve_env "$COMMONS_ENV_REMOTE"
  commons_guard
  [ -n "$(commons_vault_for_env "$COMMONS_CURRENT_ENV")" ] || commons_die "projeto sem vault"
  scope=$(commons_scope "$module" code)
  commons_check_scope "$scope" || commons_die "escopo $scope vazio"
  commons_scope_names "$scope"
}

cmd_db() {
  module="$1"
  commons_prepare "$module" code "$COMMONS_ENV_LOCAL"
  dir=$(commons_dir "$module" code)
  CI_CACHE_DIR="$dir/.ci-cache"
  export CI_CACHE_DIR
  commons_run_in "$dir" sh -c 'sh "$0/lib/dbcheck.sh" die || exit 1; [ -n "${DATABASE_URL-}" ] || { echo "commons: sem DATABASE_URL" >&2; exit 1; }; command -v psql >/dev/null 2>&1 || { echo "commons: psql não encontrado" >&2; exit 1; }; exec psql "$DATABASE_URL"' "$COMMONS_HOME"
}

prepare_ops() {
  module="$1"
  hook="$2"
  commons_prepare "$module" "code infra" "$COMMONS_ENV_REMOTE"
  infra=$(commons_dir "$module" infra)
  script="$infra/ops/$hook.sh"
  [ -f "$script" ] || commons_die "$module sem $(commons_relative "$script")"
  if [ -n "$COMMONS_SCOPES" ]; then
    code_scope=$(commons_scope "$module" code)
    infra_scope=$(commons_scope "$module" infra)
    case " $COMMONS_SCOPES " in
      *" $code_scope "*)
        case " $COMMONS_SCOPES " in
          *" $infra_scope "*) commons_check_collision "$code_scope" "$infra_scope" ;;
        esac
        ;;
    esac
  fi
  CI_CACHE_DIR="$infra/.ci-cache"
  export CI_CACHE_DIR
  if [ -n "$COMMONS_SCOPES" ] && [ -n "${code_scope-}" ]; then
    COMMONS_SECRET_KEYS=$(commons_scope_names "$code_scope" | tr '\n' ' ' | sed -e 's/ $//')
    export COMMONS_SECRET_KEYS
  fi
}

cmd_remote() {
  module="$1"
  shift
  prepare_ops "$module" remote
  run_script "$infra" "$script" "$@"
}

cmd_secrets() {
  module="$1"
  shift
  prepare_ops "$module" secrets
  [ -n "$(commons_vault_for_env "$COMMONS_CURRENT_ENV")" ] || commons_die "projeto sem vault"
  code_scope=$(commons_scope "$module" code)
  commons_check_scope "$code_scope" || commons_die "escopo $code_scope vazio"
  missing=$(commons_scope_missing "$code_scope")
  keys=$(commons_scope_names "$code_scope" | tr '\n' ' ' | sed -e 's/ $//')
  [ -z "$missing" ] || commons_die "sem valor: $missing"
  COMMONS_SECRET_KEYS="$keys"
  export COMMONS_SECRET_KEYS
  run_script "$infra" "$script" "$@"
}

compose_check() {
  version=$(docker compose version --short 2>/dev/null) || commons_die "docker compose >= 2.20"
  major=${version%%.*}
  rest=${version#*.}
  minor=${rest%%.*}
  major=${major#v}
  if [ "$major" -lt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -lt 20 ]; }; then
    commons_die "docker compose >= 2.20"
  fi
  COMPOSE_PROJECT_NAME="$COMMONS_PROJECT"
  export COMPOSE_PROJECT_NAME
}

cmd_up() {
  compose_check
  exec docker compose up -d --wait "$@"
}

cmd_down() {
  compose_check
  exec docker compose down --remove-orphans "$@"
}

cmd_logs() {
  compose_check
  exec docker compose logs -f "$@"
}

cmd_github_setup() {
  . "$COMMONS_HOME/lib/github.sh"
  commons_github_setup
}

cmd_update() {
  git -C "$COMMONS_HOME" fetch --tags
  git -C "$COMMONS_HOME" checkout "$COMMONS_REF"
}

cmd_build_image() {
  module="$1"
  target="$2"
  shift 2
  commons_image_build "$module" "$target" "$@"
}

cmd_help() {
  printf 'commands (make):\n'
  printf '  <m>.lint|audit|test|build|validate|plan  run the module hook\n'
  printf '  <m>.<name>                               run <code>/run/<name>\n'
  printf '  <m>.shell|db|keys|remote|secrets         shell, psql, key names, remote hook, secret push\n'
  printf '  build-image <m> <dev|release>            build the module image [--tag T] [--platform P] [--push]\n'
  printf '  up|down|logs                             compose services\n'
  printf '  conform|github.setup|commons.update      project checks and maintenance\n'
  [ -f "$COMMONS_ROOT/.github/modules.json" ] || return 0
  for module in $(python3 -I "$COMMONS_HOME/lib/modules.py" "$COMMONS_ROOT" list); do
    dir=$(python3 -I "$COMMONS_HOME/lib/modules.py" "$COMMONS_ROOT" dir "$module" code)
    printf '\nmodule %s\n' "$module"
    for script in "$COMMONS_ROOT/$dir"/run/*; do
      [ -e "$script" ] || continue
      printf '  %s.%s\n' "$module" "$(basename "$script")"
    done
  done
  files=""
  [ -f "$COMMONS_ROOT/Makefile" ] && files="$COMMONS_ROOT/Makefile"
  for file in "$COMMONS_ROOT"/.project/make/*.mk; do
    [ -f "$file" ] && files="$files $file"
  done
  [ -n "$files" ] || return 0
  # shellcheck disable=SC2086
  targets=$(grep -hE '^[A-Za-z0-9_.-]+:.*##' $files | sed -e 's/:.*##[[:space:]]*/  /')
  [ -z "$targets" ] || printf '\nproject\n%s\n' "$targets"
}

cmd_conform() {
  . "$COMMONS_HOME/lib/conform.sh"
  commons_conform
}

[ "$#" -ge 1 ] || commons_die "uso: commons <hook|run|shell|keys> <módulo> ..."
command="$1"
shift
case "$command" in
  help | -h | --help | conform) ;;
  *) commons_load_ctx ;;
esac

case "$command" in
  hook) [ "$#" -ge 2 ] || commons_die "uso: commons hook <módulo> <step>"; cmd_hook "$@" ;;
  run) [ "$#" -ge 2 ] || commons_die "uso: commons run <módulo> <nome>"; cmd_run "$@" ;;
  shell) [ "$#" -ge 1 ] || commons_die "uso: commons shell <módulo>"; cmd_shell "$@" ;;
  db) [ "$#" -ge 1 ] || commons_die "uso: commons db <módulo>"; cmd_db "$@" ;;
  remote) [ "$#" -ge 1 ] || commons_die "uso: commons remote <módulo>"; cmd_remote "$@" ;;
  secrets) [ "$#" -ge 1 ] || commons_die "uso: commons secrets <módulo>"; cmd_secrets "$@" ;;
  build-image) [ "$#" -ge 2 ] || commons_die "uso: commons build-image <módulo> <dev|release>"; cmd_build_image "$@" ;;
  up) cmd_up "$@" ;;
  down) cmd_down "$@" ;;
  logs) cmd_logs "$@" ;;
  github-setup) cmd_github_setup ;;
  update) cmd_update ;;
  help | -h | --help) cmd_help ;;
  conform) cmd_conform ;;
  keys) [ "$#" -ge 1 ] || commons_die "uso: commons keys <módulo>"; cmd_keys "$@" ;;
  *) commons_die "comando $command desconhecido" ;;
esac
